# Ignore everything except essential files
*

# But include these essential files
!app.py
!requirements.txt
!vercel.json
!*.py

# Explicitly ignore large folders and files
venv/
**/site-packages/
**/*.pkl
**/*.ipynb
**/*.log
**/*.dll
**/*.pyd
**/*.exe
**/*.js
**/*.css
**/*.map
**/*.svg
**/*.ttf
**/*.eot
**/*.dat
**/*.npz
**/*.npy
**/*.gz
**/*.tar
